[Unit]
# Appends every room's export ring to the local archive (append + seq dedupe).
# Runs every 6 hours; kept separate from the 15-minute watcher because all 8
# rooms total ~40 MB.
# Install (needs sudo; this file lives in the repo):
#   sudo cp /opt/lumi-observatory/infra/systemd/lumi-archive-rooms.service /etc/systemd/system/
#   sudo cp /opt/lumi-observatory/infra/systemd/lumi-archive-rooms.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lumi-archive-rooms.timer
# Manual run:
#   sudo systemctl start lumi-archive-rooms.service
Description=LUMI room archiver (technocore export ring)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/lumi-observatory
Environment=TECHNOCORE_BASE_URL=https://technocore.chat
Environment=LUMI_ARCHIVE_DIR=/var/lib/lumi-earn/archives
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lumi-observatory/.venv-earn/bin/python apps/tools/archive_rooms.py --once
TimeoutStartSec=900
StandardOutput=append:/var/log/lumi-archive-rooms.log
StandardError=append:/var/log/lumi-archive-rooms.log

[Install]
WantedBy=multi-user.target
