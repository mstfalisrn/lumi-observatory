[Unit]
# 15 dakikada bir program bekçisini çalıştırır. Persistent=true: makine kapalı
# kaldıysa kaçırılan tur açılışta telafi edilir (yazımlar idempotent olduğu için
# telafi güvenlidir).
Description=LUMI program bekçisi zamanlayıcısı (15 dakikada bir)

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=30
AccuracySec=10s
Unit=lumi-program-watch.service

[Install]
WantedBy=timers.target
