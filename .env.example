# =========================================================
# LUMI Agentic Observatory — example environment file
# Copy: cp .env.example .env — never commit real secrets
# All values here are placeholders (CHANGE_ME). Real secrets
# live outside the repo (e.g. quickstart.sh generates them).
# Verify: ./scripts/secret-scan.sh .
# =========================================================

# --- General ---
APP_ENV=development        # development | production
APP_TIMEZONE=UTC  # UTC in DB, converted to user timezone in UI
SCHEMA_VERSION=1

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=lumi
POSTGRES_DB=lumi
POSTGRES_PASSWORD=CHANGE_ME          # sourced from secrets file in production
DATABASE_URL=postgresql+psycopg://lumi:CHANGE_ME@lumi-postgres:5432/lumi

# --- Redis 7 (job queue) ---
REDIS_URL=redis://lumi-redis:6379/0

# --- API / Gateway ---
API_PORT=8000
GATEWAY_HOST=0.0.0.0

# --- Security ---
JWT_SECRET=CHANGE_ME                 # 64 hex characters
SESSION_ENCRYPTION_MASTER_KEY=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
ADMIN_EMAIL=admin@example.com        # initial admin login
ADMIN_PASSWORD_HASH=CHANGE_ME        # PBKDF2 hash; if CHANGE_ME, quickstart.sh generates one automatically
# Cloudflare Access (production) — origin JWT verification
CLOUDFLARE_ACCESS_AUD=CHANGE_ME      # Access app AUD tag
CLOUDFLARE_ACCESS_CERT_PEM_PATH=/run/secrets/access-cert.pem

# --- Telegram ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ALLOWED_USER_IDS=           # comma-separated numeric IDs; '*' or empty = access disabled
TELEGRAM_GROUP_ENABLED=false

# --- LLM Provider (OpenAI-compatible) ---
# LUMI speaks OpenAI Chat Completions at {base_url}/chat/completions.
# Mock needs no key. All other providers use openai_compatible.
# Wizard ./scripts/setup.sh offers 18 presets (incl. OpenCode Free/Go/Zen) + Custom (covers all 40+ providers).
# Full mapping: docs/CONFIGURATION.md
LLM_PROVIDER=mock                    # mock | openai_compatible
LLM_BASE_URL=https://api.openai.com/v1   # preset examples:
                                     #  OpenAI: https://api.openai.com/v1
                                     #  OpenRouter: https://openrouter.ai/api/v1
                                     #  DeepSeek: https://api.deepseek.com/v1
                                     #  Grok: https://api.x.ai/v1
                                     #  Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
                                     #  Qwen: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
                                     #  MiniMax: https://api.minimax.chat/v1
                                     #  Kimi: https://api.moonshot.cn/v1
                                     #  Fireworks: https://api.fireworks.ai/inference/v1
                                     #  HF: https://router.huggingface.co/v1
                                     #  Ollama: http://host.docker.internal:11434/v1
                                     #  LM Studio: http://host.docker.internal:1234/v1
                                     #  vLLM: http://host.docker.internal:8000/v1
                                     #  OpenCode Free: https://opencode.ai/api/free/v1 (keyless)
                                     #  OpenCode Go: https://opencode.ai/zen/go/v1
                                     #  OpenCode Zen: https://opencode.ai/zen/v1
                                     #  Custom: any OpenAI-compatible URL
LLM_MODEL=gpt-4o-mini                # e.g. gpt-4o-mini, deepseek-chat, grok-3-mini,
                                     # gemini-2.0-flash, qwen-plus, llama3.1, your-model
LLM_API_KEY=CHANGE_ME                # ignored for mock; set via wizard or manually
LLM_SESSION_ID=                       # e.g. lumi-server; sent as x-opencode-session (required by OpenCode Zen Go free tier)
LLM_USER_AGENT=                       # browser-like UA override for Cloudflare-protected providers (default: Chrome UA)

# --- Agent limits (guardrails) ---
RUN_MAX_ITERATIONS=40
RUN_MAX_TOOL_CALLS=80
RUN_MAX_WALL_SECONDS=900
RUN_MAX_TOKEN_BUDGET=200000
RUN_MAX_COST_BUDGET=5.0

# --- Connector SSRF ---
CONNECTOR_ALLOWED_HOSTS=             # empty = deny-list only (loopback/rfc1918/metadata)
CONNECTOR_MAX_RESPONSE_BYTES=1048576
CONNECTOR_MAX_REDIRECTS=3
TECHNOCORE_ROOM_REACT_ENABLED=false  # high-risk message → signed warning posted INTO the room (external write)
TECHNOCORE_ROOM_REACT_INTERVAL=300   # min seconds between room reactions (0 = unlimited)

# --- Proactive observation (sources) ---
# All source monitoring is opt-in. Sources can be created while the monitor is
# off; scheduled scans only run when SOURCE_MONITOR_ENABLED=true.
SOURCE_MONITOR_ENABLED=false         # master switch for scheduled/auto source scans
SOURCE_MONITOR_MAX_PER_TICK=10       # sources scanned per scheduler tick (rate cap)
SOURCE_MEMORY_CANDIDATES_ENABLED=true # changed sources may create memory candidates (never auto-active)
SOURCE_MEMORY_TTL_SECONDS=604800     # 7 days; candidate TTL for observed content

# --- Report-only digests ---
# Digests are deterministic local reports. They NEVER leave the server unless a
# separate delivery connector is explicitly configured (delivery stays disabled).
DIGEST_ENABLED=false                 # enables digest schedule generation
DIGEST_MAX_SCHEDULES_PER_TICK=10
DIGEST_DELIVERY_ENABLED=false        # reserved: external digest delivery must stay off

# --- Risk notifications (external Telegram write — opt-in) ---
RISK_ALERTS_ENABLED=false            # when true, RISKY/DANGEROUS findings may alert Telegram

# --- Memory auto-promotion ---
MEMORY_AUTO_PROMOTE_THRESHOLD=0.85


# --- Technocore (optional integration, disabled by default) ---
TECHNOCORE_ENABLED=false
TECHNOCORE_BASE_URL=
TECHNOCORE_ROOM_CLAIM=
TECHNOCORE_MONITORED_ROOMS=
TECHNOCORE_ED25519_KEY_PATH=

# --- GitHub (optional) ---
DEFAULT_GITHUB_REPO=           # e.g. your-owner/your-repo; empty = no auto GitHub actions

# --- Frontend (exposed to browser) ---
VITE_API_BASE=/api
VITE_WSS_BASE=/events
