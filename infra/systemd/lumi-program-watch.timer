[Unit]
# Runs the program watcher every 15 minutes. Persistent=true: runs missed while
# the machine was down are caught up on boot (safe because the writes are
# idempotent).
Description=LUMI program watcher timer (every 15 minutes)

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=30
AccuracySec=10s
Unit=lumi-program-watch.service

[Install]
WantedBy=timers.target
